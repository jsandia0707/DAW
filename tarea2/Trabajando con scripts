Añadir puerto de escucha a la configuración de Apache
def add_listen_port_to_apache_config(port):
    config_file_path = '/etc/apache2/ports.conf'
    port_line = f'Listen {port}\n'
    
    # Leer la configuración actual
    with open(config_file_path, 'r') as file:
        lines = file.readlines()
    
    # Comprobar si el puerto ya existe
    for line in lines:
        if line.strip() == port_line.strip():
            return "Puerto ya presente"
    
    # Añadir nuevo puerto
    with open(config_file_path, 'a') as file:
        file.write(port_line)
    
    return "Puerto añadido con éxito"
Añadir dominio e IP al fichero hosts
def add_domain_to_hosts(domain, ip):
    hosts_file_path = '/etc/hosts'
    entry = f'{ip} {domain}\n'

    # Leer el fichero hosts actual
    with open(hosts_file_path, 'r') as file:
        lines = file.readlines()

    # Comprobar si el dominio ya existe
    for line in lines:
        if domain in line:
            return "Dominio ya presente"

    # Añadir nuevo dominio
    with open(hosts_file_path, 'a') as file:
        file.write(entry)

    return "Dominio añadido con éxito"
Crear una página web simple
def create_web_page(title, header, message):
    html_content = f"""
    <html>
    <head>
        <title>{title}</title>
    </head>
    <body>
        <h1>{header}</h1>
        <p>{message}</p>
    </body>
    </html>
    """
    
    with open('index.html', 'w') as file:
        file.write(html_content)
    
    return "Página web creada con éxito"
